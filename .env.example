# Christina Lab environment template
# Copy this file to .env for local development.
# Never commit the real .env file.

# YouTube Data API
YOUTUBE_API_KEY=

# Database (used in later milestones)
DATABASE_URL=sqlite:///./christina_lab.sqlite3

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Creator Agent AI provider (server-side only)
# Default: Gemini. Optional fallbacks run only if you explicitly list them.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=

# Gemini (recommended free alpha)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional free / alternate providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/KristineLio/christina-lab

# Optional paid OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional self-hosted OpenAI-compatible model
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
